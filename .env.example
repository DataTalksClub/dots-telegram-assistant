# Copy locally to .env, chmod 600 .env, and replace placeholders. Never commit it.
TELEGRAM_BOT_TOKEN=replace_with_botfather_token
OPENAI_API_KEY=replace_with_openai_api_key
# Verify these with: python -m telegram_assistant.identify
ALLOWED_TELEGRAM_USER_IDS=replace_with_your_numeric_user_id
ALLOWED_TELEGRAM_CHAT_IDS=replace_with_your_numeric_private_chat_id
# Choose a Responses-compatible model available to your OpenAI API project.
OPENAI_MODEL=gpt-4.1-mini
DATABASE_PATH=data/assistant.sqlite3
MAX_INPUT_CHARS=8000
MAX_CONTEXT_CHARS=24000
MAX_OUTPUT_TOKENS=1200
MAX_HISTORY_TURNS=12
# Global across all users and retries; resets at midnight UTC. Not a dollar cap.
MAX_DAILY_CALLS=50
MAX_ATTEMPTS=3
