# Copy to .env, chmod 600 .env, and replace placeholders locally. Never commit secrets.
TELEGRAM_BOT_TOKEN=replace_with_botfather_token
# One verified owner. Positive numeric sender ID must equal private chat ID.
TELEGRAM_USER_ID=replace_with_your_numeric_user_id
TELEGRAM_CHAT_ID=replace_with_your_numeric_private_chat_id
# Production: external OAuth 2.1 provider issuing RS256 access tokens.
AUTH_MODE=oauth
OAUTH_ISSUER=https://replace-with-your-identity-provider.example
OAUTH_AUDIENCE=https://replace-with-your-public-plugin-domain.example/mcp
OAUTH_JWKS_URL=https://replace-with-your-identity-provider.example/.well-known/jwks.json
# Exact verified owner subject from your issuer; not a display name or email guess.
OAUTH_SUBJECT=replace_with_your_exact_owner_subject
# Local development only: AUTH_MODE=bearer plus a random MCP_AUTH_TOKEN >=32 chars.
# Generate locally: python3 -c 'import secrets; print(secrets.token_urlsafe(48))'
# MCP_AUTH_TOKEN=replace_with_a_generated_random_secret
# Required: exact comma-separated trusted HTTPS callback hostnames from your MCP client.
# No wildcards, URL paths, schemes, ports, or arbitrary domains. Do not guess dot endpoints.
CALLBACK_ALLOWED_HOSTS=replace_with_verified_callback_hostname
STATE_PATH=/data/events.sqlite3
BIND_HOST=127.0.0.1
PORT=8765
